[Unit]
Description=Sebas panel - Next.js admin dashboard
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=sebas
# next build com output:"standalone" em monorepo gera server.js dentro de
# .next/standalone/packages/panel/, nao na raiz — e nao copia public/ nem .next/static
# sozinho, isso e' passo manual de deploy (ver README "Rodando localmente" / redeploy).
WorkingDirectory=/opt/sebas/sebas-bot/packages/panel/.next/standalone/packages/panel
EnvironmentFile=/opt/sebas/sebas-bot/packages/panel/.next/standalone/packages/panel/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=2

MemoryMax=250M

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
