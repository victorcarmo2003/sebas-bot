[Unit]
Description=Sebas worker - cron, fila e execucao de modulos
After=network.target

[Service]
Type=simple
User=sebas
WorkingDirectory=/opt/sebas/bot
EnvironmentFile=/opt/sebas/bot/.env
ExecStart=/usr/bin/node dist/bin/worker.js
Restart=always
RestartSec=2
StartLimitIntervalSec=0

# Processo que roda trabalho pesado (fetch de RSS, chamadas de IA) - isolado do
# sebas-bot de proposito, pra um job travado nunca competir por memoria com o webhook.
MemoryMax=350M
OOMScoreAdjust=200

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sebas/bot/data

[Install]
WantedBy=multi-user.target
