[Unit]
Description=Sebas gateway - conexao persistente com o Discord Gateway (conversa passiva)
After=network.target sebas-bot.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=sebas
WorkingDirectory=/opt/sebas/sebas-bot/packages/core
EnvironmentFile=/opt/sebas/sebas-bot/packages/core/.env
ExecStart=/usr/bin/node dist/bin/gateway.js
Restart=always
RestartSec=2

# So mantem um socket e repassa mensagem via HTTP interno pro sebas-bot — nao toca o banco,
# nao roda IA/tools direto, por isso o teto de memoria e' bem menor que os outros dois.
MemoryMax=80M

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
