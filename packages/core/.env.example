# Discord — criar app em https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# Discord ID (numerico) do dono do bot — vira role "owner" automatico na admin API
# (ver resolveAdmin em src/core/admin-api/rbac.ts), sem precisar de linha na tabela admins.
OWNER_DISCORD_ID=

# Secret compartilhado entre este core e o painel (packages/panel) — o painel manda
# "Authorization: Bearer <isto>" em toda chamada pra /api/admin/*.
ADMIN_API_SECRET=

# Opcionais — todos tem default sensato em src/core/config/env.ts
DB_PATH=data/sebas.db
BOT_PORT=8080
MCP_PORT=8090
PANEL_URL=http://127.0.0.1:3000

# Token do GitHub NAO entra aqui — e' configurado pelo painel (pendencia "Configure um token
# do GitHub" na home, ou POST /api/admin/github/token), salvo em github_settings no banco.
# So necessario pra GET /api/admin/modules/discover (busca de modulos/servidores MCP no GitHub).
